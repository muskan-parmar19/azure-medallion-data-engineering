
-CREATE CALENDAR VIEW-------
create view gold.calendar
AS
SELECT
*
from
   OPENROWSET
   (
     BULK 'https://awstoragedatalakemusk.blob.core.windows.net/silver/AdventureWorks_Calendar/',
     FORMAT = 'Parquet'
     ) as quer1



